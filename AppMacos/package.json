{
  "name": "vryx-desktop",
  "productName": "Vryx",
  "private": true,
  "version": "1.0.7",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && npm run electron:start\"",
    "electron:build": "npm run build && electron-builder",
    "build:win": "npm run build && electron-builder --win",
    "build:win:installer": "npm run build && electron-builder --win nsis",
    "build:win:signed": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && electron-builder --win nsis -c electron-builder.win-signed.cjs && node electron/verify-win-signature.cjs",
    "verify:win-signature": "node electron/verify-win-signature.cjs",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac:unsigned": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && electron-builder --mac --dir -c.mac.identity=null",
    "build:mac:signed": "npm run build && electron-builder --mac dmg zip"
  },
  "dependencies": {
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "systeminformation": "^5.31.5",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.0.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.4.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "wait-on": "^9.0.5"
  },
  "build": {
    "productName": "Vryx",
    "appId": "com.vryx.node",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "afterPack": "electron/clean-xattrs.cjs",
    "afterSign": "electron/notarize.cjs",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Vryx-Worker-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vryx Worker",
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "../nodeAndWorker",
        "to": "nodeAndWorker",
        "filter": [
          "**/*",
          "!**/target/**",
          "!**/venv/**",
          "!**/.git/**",
          "!**/.DS_Store",
          "!Cargo.*",
          "!*.md",
          "!*.ps1",
          "!mac_setup.sh",
          "!quick-local-p2p.sh",
          "!run_*",
          "!test_*",
          "!start-3-workers-*",
          "!start-initiator.sh",
          "!start-mac-*",
          "!stop-3-workers-*",
          "!vps_deploy.py",
          "!**/.vryx-keys/**",
          "!**/.vryx-keys-mac/**",
          "!**/logs/**",
          "!**/*.log",
          "!**/__pycache__/**",
          "!**/.pytest_cache/**"
        ]
      }
    ]
  }
}
