# Copier vers server/.env puis :
#   docker compose --env-file server/.env up -d
# pour que DB_PASSWORD = mot de passe MariaDB dans le conteneur.

PORT=4000
NODE_ENV=development

DB_HOST=127.0.0.1
# Port sur votre Mac pour joindre MariaDB. Avec Docker, même valeur que MARIADB_PORT ci-dessous.
# Si « address already in use » sur 3306 (MySQL/MariaDB déjà installé), mettez 3307 aux deux lignes.
DB_PORT=3306
MARIADB_PORT=3306

DB_USER=velocity
DB_PASSWORD=velocity_dev
DB_NAME=velocity

# Générez une chaîne longue et aléatoire (ex. openssl rand -base64 48)
JWT_SECRET=remplacez_par_une_secret_jwt_tres_longue_au_moins_32_caracteres
JWT_EXPIRES_DAYS=7

# Google OAuth (connexion/login social)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URI de callback Google.
# Recommandé : https://vryx.eu/compte
GOOGLE_OAUTH_REDIRECT_URI=

# Admins application (e-mails séparés par des virgules, minuscules). Surcharge la liste par défaut du serveur.
ADMIN_EMAILS=julientruffier.dev@gmail.com,baptiste.peru@gmail.com

# Origines du front (CSV). En production, uniquement des origines HTTPS publiques.
CORS_ORIGIN=http://localhost:5173

# Cookie : true en HTTPS production uniquement
COOKIE_SECURE=false

# Taille max JSON acceptée par l'API. Défaut: 8mb en dev, 1mb en production.
# VRYX_JSON_BODY_LIMIT=1mb

# Secret partagé workers/initiator/runtime. Obligatoire en production.
# Génération: openssl rand -hex 32
VRYX_WORKER_SECRET=
# Alias historique encore accepté côté serveur et workers.
WORKER_INFERENCE_DELEGATE_SECRET=
# Secret localhost pour endpoints internes Express <-> runtime/initiator.
# Obligatoire en production. Génération: openssl rand -hex 32
VRYX_INTERNAL_TOKEN=
# Dev uniquement. Ignoré en production: les routes workers restent authentifiées.
# ALLOW_UNSECURE_WORKERS=1

# Chat P2P admin : URL du daemon initiateur (Axum) sur la machine qui héberge l’API.
# Toute l’inférence passe désormais par ce daemon (gRPC vers les nœuds), sans dépendance Web2.
# Exemple dev local si le daemon écoute sur un autre port : http://127.0.0.1:3090
VRYX_INITIATOR_CHAT_URL=http://127.0.0.1:3031
# Plafond max_new_tokens pour le chat P2P admin (256–65536, défaut 16384). Le pipeline Python peut encore borner via VRYX_DIST_MAX_TOKENS sur le stage1.
# VRYX_P2P_ADMIN_MAX_NEW_TOKENS=16384
# Timeout côté API OpenAI-compatible vers l'initiateur. Évite qu'un worker en chargement bloque le chemin argent.
VRYX_OPENAI_UPSTREAM_TIMEOUT_MS=60000
# Optionnel : préfixes CSV (origines HTTP) pour autoriser le champ JSON initiator_chat_url (orchestrateur edge).
# Laisser vide interdit toute surcharge depuis le client (recommandé prod si non requis).
# VRYX_ALLOWED_INITIATOR_CHAT_PREFIXES=http://127.0.0.1:3031,http://127.0.0.1:3090
# Répertoire persistant qui sert les shards via /api/internal/shard-serve.
VRYX_SHARD_BASE_DIR=/var/lib/vryx-shards
# Seuil « hors ligne » pour /api/workers/status (liste vue par initiateur P2P, secondes après dernier heartbeat)
# À augmenter pour les pools domiciliés où le heartbeat peut manquer plusieurs minutes alors que la session P2P est encore vivante (ex. 43200 pour 12 h).
# WORKER_OFFLINE_SEC=90
# Seuil « worker live » pour la sidebar (secondes depuis le dernier heartbeat)
WORKER_LIVE_SEC=30

# Pricing API et crédits prépayés.
VRYX_EUR_PER_MILLION=0.3
VRYX_BILLING_CREDIT_PACKAGES_EUR=50,100,500,2000
# Mode recommandé pour VPS dev/staging investisseur sans paiement bancaire réel.
# admin_credit = recharges via admin + ledger; stripe_test/live = checkout Stripe.
VRYX_BILLING_MODE=admin_credit
# Active le blocage 402 si le solde client ne couvre pas le coût estimé avant appel API.
# Laisser à 0 pendant migration pour ne pas couper les clients déjà créés sans crédit initial.
VRYX_BILLING_ENFORCE_CREDITS=1
VRYX_APP_BASE_URL=https://vryx.eu
# 0 coupe checkout/webhook même si une ancienne clé Stripe reste dans l'environnement.
STRIPE_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Redis/Valkey : recommandé obligatoire sur le VPS de démonstration, optionnel en local pur.
REDIS_ENABLED=1
REDIS_REQUIRED_IN_PROD=1
REDIS_URL=redis://:<password>@127.0.0.1:6379/0

# Endpoint CI bench interne: /api/internal/bench/chat.
# Ne pas exposer publiquement; configurer le même token dans GitHub Secrets.
VRYX_BENCH_TOKEN=

# Golden path benchmark: seuils obligatoires et artefacts JSON.
VRYX_GOLDEN_BENCH_ARTIFACT_DIR=/var/www/vryx/var/golden-path
VRYX_GOLDEN_BENCH_MIN_REQUESTS=2
VRYX_GOLDEN_BENCH_MIN_SUCCESS_RATE=99
VRYX_GOLDEN_BENCH_MAX_EMPTY_RESPONSES=0
VRYX_GOLDEN_BENCH_MIN_TPS_P50=10
VRYX_GOLDEN_BENCH_MAX_TTFT_P95_MS=10000
