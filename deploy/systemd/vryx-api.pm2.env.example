PORT=4000
VRYX_INITIATOR_CHAT_URL=http://127.0.0.1:3031
VRYX_SHARD_BASE_DIR=/var/lib/vryx-shards
WORKER_LIVE_SEC=15
WORKER_OFFLINE_SEC=90
VRYX_P2P_ADMIN_MAX_NEW_TOKENS=16384

# VPS dev/staging investor demo:
# admin_credit keeps the money path real without live card payment.
VRYX_BILLING_MODE=admin_credit
VRYX_BILLING_ENFORCE_CREDITS=1
STRIPE_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Redis/Valkey must stay active on the demo VPS.
REDIS_ENABLED=1
REDIS_REQUIRED_IN_PROD=1
REDIS_URL=redis://:<password>@127.0.0.1:6379/0
